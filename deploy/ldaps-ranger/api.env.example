# Merge with the production database/OpenMetadata/Bedrock settings, injected via Secrets.
EDQ_ENVIRONMENT=production
EDQ_AUTH_MODE=trino_ldaps
EDQ_AUTHORIZATION_PROVIDER=trino_ranger
EDQ_LDAPS_IDENTITY_NAMESPACE=REPLACE_WITH_DIRECTORY_NAMESPACE
EDQ_EXECUTOR=trino
EDQ_TRINO_AUTH=ldap_password
EDQ_TRINO_SCHEME=https
EDQ_TRINO_HOST=REPLACE_WITH_TRINO_COORDINATOR
EDQ_TRINO_PORT=8443
EDQ_TRINO_CA_BUNDLE=/etc/edq/trust/trino-ca.pem
EDQ_POLICY_PATH=/etc/edq/discovery.json
EDQ_LOGIN_FAILURE_LIMIT=5
EDQ_LOGIN_FAILURE_WINDOW_SECONDS=60
# Streamlit deployment variables (not API settings):
EDQ_UI_AUTH_MODE=ldaps
EDQ_API_URL=https://REPLACE_WITH_INTERNAL_API_HOST
EDQ_API_CA_BUNDLE=/etc/edq/trust/api-ca.pem
EDQ_UI_LDAPS_SESSION_SECONDS=900
