# Run python scripts/local_secrets.py to generate an ignored .env for Compose.
# This file contains names only. Never put real credentials in source control.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SOURCE_DB_PASSWORD=

# Offline development defaults (no Docker required).
EDQ_ENVIRONMENT=development
EDQ_AUTH_MODE=development
EDQ_DATABASE_URL=sqlite:///./.runtime/sessions.db
EDQ_EXECUTOR=sqlite_demo
EDQ_METADATA_PROVIDER=fixture
EDQ_LLM_PROVIDER=mock
EDQ_MAX_ROWS=200
EDQ_QUERY_TIMEOUT_SECONDS=20
EDQ_MAX_CONCURRENT_JOBS=4
EDQ_MAX_USER_JOBS=2
EDQ_AUDIT_STORE_TEXT=false
EDQ_RETENTION_DAYS=30

# Live configuration: use a secret manager / workload identity, not this file.
# EDQ_ENVIRONMENT=production
# EDQ_AUTH_MODE=oidc
# EDQ_OIDC_ISSUER=https://identity.example/realms/bank
# EDQ_OIDC_AUDIENCE=edq-api
# EDQ_OIDC_JWKS_URL=https://identity.example/realms/bank/protocol/openid-connect/certs
# EDQ_OIDC_ROLES_CLAIM=roles
# EDQ_DATABASE_URL=postgresql+psycopg://edq_app:<secret>@sessions/edq
# EDQ_EXECUTOR=trino
# EDQ_TRINO_SCHEME=https
# EDQ_TRINO_HOST=trino.example
# EDQ_TRINO_PORT=8443
# EDQ_TRINO_AUTH=jwt_passthrough
# EDQ_TRINO_TOKEN_AUDIENCE=trino
# EDQ_TRINO_CA_BUNDLE=/etc/edq/ca.pem
# EDQ_METADATA_PROVIDER=openmetadata
# EDQ_OM_URL=https://metadata.example
# EDQ_OM_TOKEN=<secret>
# EDQ_OM_EXPECTED_VERSION=2.0
# EDQ_OM_TABLE_FIELDS=owners,tags,tableConstraints,extension
# EDQ_OM_LINEAGE_ENABLED=false
# EDQ_OM_CLASSIFICATION_MAP={"Sensitivity.Public":"public","Sensitivity.Internal":"internal","Sensitivity.Restricted":"restricted"}
# EDQ_MODEL_METADATA_SENSITIVITIES=["public","internal"]
# EDQ_LLM_PROVIDER=bedrock
# EDQ_BEDROCK_MODEL_ID=<approved-model-or-inference-profile>
# EDQ_AWS_REGION=me-central-1

# Alternative LDAPS + existing CDP Ranger profile (complete guide: docs/LDAPS_RANGER.md):
# EDQ_AUTH_MODE=trino_ldaps
# EDQ_AUTHORIZATION_PROVIDER=trino_ranger
# EDQ_LDAPS_IDENTITY_NAMESPACE=<stable-directory-name>
# EDQ_TRINO_AUTH=ldap_password
# EDQ_TRINO_SCHEME=https
# EDQ_UI_AUTH_MODE=ldaps
# EDQ_API_URL=https://internal-api.example
# EDQ_API_CA_BUNDLE=/etc/edq/api-ca.pem
# EDQ_UI_LDAPS_SESSION_SECONDS=900
# Keep user passwords out of this file: credentials are supplied through the HTTPS login form.
